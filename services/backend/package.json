{
  "name": "@carniceria/backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:supabase": "ENV_FILE=.env.supabase nodemon --exec ts-node src/server.ts",
    "build": "npm --prefix ../.. --workspace=@carniceria/shared run build && tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.ts src/__tests__/integration",
    "test:unit": "vitest run --config vitest.unit.config.ts src/__tests__/unit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "pg": "^8.20.0",
    "puppeteer": "^25.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
